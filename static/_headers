# HTTP response headers, applied by Cloudflare Pages.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
#
# The CSP is strict: scripts and fetch() only from this origin (that
# covers the desktop script and its /index.json search index), styles and images
# only from this origin, nothing loaded from anywhere else. The
# <script type="application/ld+json"> SEO blocks are inert data and are
# not affected by script-src.
#
# manifest-src and worker-src are for the DVD Tracker (/tools/dvds/):
# its web app manifest (Add to Home Screen) and its offline service
# worker. Both are same-origin only.
#
# If you ever add:
#   - an image hosted on another domain -> extend img-src
#   - another script                    -> host it on this origin
#   - embeds (YouTube etc.)             -> COEP below will block them; relax it knowingly

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; connect-src 'self'; img-src 'self'; style-src 'self'; font-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), web-share=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none

# The DOS games (pages under /games/) run in an emulator
# that is WebAssembly inside a web worker. That needs two things the
# strict policy above doesn't give: permission to compile WebAssembly
# ('wasm-unsafe-eval', which allows nothing else: no eval(), no inline
# script) and a worker started from a blob: URL. Everything is still
# loaded from this site only (static/dos/). The game pages alone get it.
/games/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; img-src 'self'; style-src 'self'; font-src 'self'; manifest-src 'self'; worker-src 'self' blob:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# Fingerprinted assets: the filename changes when the content changes,
# so these can be cached forever.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
# Self-hosted fonts carry their version in the file name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Desktop icons, the DOS emulator and games, and the original shareware
# archives keep their file names; a week is plenty.
/icons/*
  Cache-Control: public, max-age=604800
/dos/*
  Cache-Control: public, max-age=604800
/downloads/*
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/og-card.png
  Cache-Control: public, max-age=86400

# Planedex (/tools/planedex/): an airliner's entry shows a photo of the
# exact plane, looked up live from Planespotters.net. Their terms say
# the images must load straight from their servers, so this one page
# gets a CSP that allows their API and image host, plus its web-app
# manifest. COEP would block those cross-origin images, so it's dropped
# here only. Every other photo is served from the site itself.
/tools/planedex/*
  ! Content-Security-Policy
  ! Cross-Origin-Embedder-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; connect-src 'self' https://api.planespotters.net; img-src 'self' https://t.plnspttrs.net; style-src 'self'; font-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
# Photos, logos and flags keep their file names, so browsers can hold on
# to them; the index.json lists next to them are checked on every visit.
/tools/planedex/photos/*.webp
  Cache-Control: public, max-age=604800
/tools/planedex/logos/*.webp
  Cache-Control: public, max-age=604800
/tools/planedex/flags/*.webp
  Cache-Control: public, max-age=2592000
