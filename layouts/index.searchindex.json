{{- /* Search index: every post's title, url and date. Rebuilt on every build. */ -}}
{{- $posts := where site.RegularPages "Section" "ne" "" -}}
[{{ range $i, $p := $posts }}{{ if $i }},{{ end }}{"title":{{ $p.Title | jsonify }},"url":{{ $p.RelPermalink | jsonify }},"date":{{ $p.Date.Format "2006-01-02" | jsonify }}}{{ end }}]
