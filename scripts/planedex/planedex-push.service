# Planedex: push the receiver's catches to cfworx.tech.
# install.sh fills in the script path and copies this to ~/.config/systemd/user/.
[Unit]
Description=Planedex: push the ADS-B catches to cfworx.tech
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 "@SCRIPT@"
